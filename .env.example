# Konfigurasi Database MySQL (bawaan untuk XAMPP lokal)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_akademik

# Opsi SSL untuk Cloud MySQL saat deploy ke Vercel (misalnya TiDB Cloud port 4000 / Aiven).
# Aktifkan di Environment Variables Vercel jika penyedia database mewajibkan TLS/SSL:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Kunci rahasia untuk penandatanganan HMAC sesi & token CSRF.
# Buat string acak minimal 32 karakter, misalnya:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
